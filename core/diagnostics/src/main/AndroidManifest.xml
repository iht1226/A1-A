<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <activity android:name=".SensorDiagnosticsActivity" android:exported="false" />
        <service android:name=".DiagnosticBridge" android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data android:scheme="wear" android:host="*" android:pathPrefix="/sleep/diagnostics/" />
            </intent-filter>
        </service>
    </application>
</manifest>
